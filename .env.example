# ============================================================
# Stock Bot Pro — 환경변수 템플릿
# 복사해서 사용: cp .env.example .env
# ⚠️ .env 파일은 절대 저장소에 올리지 마세요!
# ============================================================

# ── 한국투자증권 (KIS) API ──
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_MODE=virtual          # virtual | real
KIS_ACCOUNT_NO=your_account_number
KIS_ACCOUNT_PRODUCT=01    # 계좌상품코드

# ── Z.AI (GLM) ──
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.1

# ── 텔레그램 ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── 거래 설정 ──
STOP_LOSS_PERCENT=5.0
TAKE_PROFIT_PERCENT=10.0
MAX_DAILY_LOSS_PERCENT=5.0
MAX_CONSECUTIVE_LOSSES=3
POSITION_SIZE_PERCENT=100.0

# ── 뉴스 스캐너 ──
NEWS_SCAN_INTERVAL=1800           # 초 (30분)
NEWS_FRESHNESS_THRESHOLD=3600     # 뉴스 신선도 기준 (초)

# ── 다종목 포지션 ──
MAX_POSITIONS_PER_MARKET=3        # 시장당 최대 종목 수
MAX_SAME_SECTOR=2                 # 같은 섹터 최대 종목 수

# ── AI 안전장치 ──
MAX_AI_POSITION_PCT=50.0          # AI 신호만으로 최대 자금 비율 %
AI_SCORE_MIN=7                    # AI 최소 점수
THEME_STRENGTH_MIN=7.0            # 메가 테마 최소 강도

# ── 진입 타점 ──
ENTRY_MAX_CHASE_PCT=2.0           # 당일 상승 최대 허용 %
ENTRY_SUPPORT_TOLERANCE=1.0       # 지지선 근처 허용 폭 %
ENTRY_MIN_VOL_RATIO=1.2           # 최소 거래량 비율

# ── 해외주식 ──
US_STOCK_ENABLED=true
KR_BUDGET=5000000
US_BUDGET=5000
MIN_ORDER_KRW=100000
MIN_ORDER_USD=100
MIN_QTY=1
US_WATCHLIST=NVDA,AMD,AVGO,INTC,SMH,SOXX,QQQ,SPY

# ── 동적 손절/익절 ──
ATR_PERIOD=14
STOP_LOSS_ATR_MULTI=2.0
TAKE_PROFIT_ATR_MULTI=3.0
STOP_LOSS_MIN_PCT=3.0
STOP_LOSS_MAX_PCT=8.0
TRAILING_STOP_ATR_MULTI=1.5
TRAILING_ACTIVATE_PCT=3.0
